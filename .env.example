# ==========================================
# Ticket Booking System - Environment Config
# ==========================================

# Application Environment
NODE_ENV=development
PORT=3000

# Client Application URL (for CORS & WebSockets)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# PostgreSQL Database URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ticket_booking?schema=public

# Redis Connection URL
REDIS_URL=redis://localhost:6379

# JWT Authentication Secrets
JWT_SECRET=super_secret_jwt_access_key_change_in_production_9f8a2b
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_in_production_1c4d7e
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Seat Hold TTL Configuration (in seconds, default: 600s = 10 minutes)
HOLD_TTL_SECONDS=600

# Waitlist Offer TTL Configuration (in seconds, default: 900s = 15 minutes)
WAITLIST_OFFER_TTL_SECONDS=900

# Email Delivery Configuration (Nodemailer)
# Test SMTP (e.g. Mailtrap / Ethereal) or real SMTP provider
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="ShowReserve Tickets <no-reply@showreserve.com>"

# QR Verification HMAC Secret
QR_SECRET=super_secure_qr_ticket_signature_hmac_secret_4a9f
